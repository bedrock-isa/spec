\NeedsTeXFormat{LaTeX2e}
\ProvidesFile{bedrock-reference/instruction.sty}[2026/08/26 Bedrock reference instruction commands]

\newcommand{\BedrockInstructionHeader}[3]{%
  \phantomsection#3%
  \Needspace{1.3in}
  \noindent\begin{tabular*}{\linewidth}{@{}l@{\extracolsep{\fill}}c r@{}}%
  {\Large\bfseries #1} & {\bfseries #2} & {\Large\bfseries #1}\\%
  \end{tabular*}
  \vspace{4pt}\hrule height 0.45pt\vspace{9pt}}
\newenvironment{BedrockInstruction}[3]{%
  \BedrockInstructionHeader{#1}{#2}{\label{#3}}%
}{%
  \par}
\newcommand{\BedrockInstructionField}[2]{\BedrockBlockField{#1:}{#2}}
\newcommand{\BedrockOperationField}[2]{%
  \par\Needspace{0.45in}%
  \noindent\begin{tabularx}{\linewidth}{@{}>{\raggedright\arraybackslash}p{1.32in}@{\hspace{0.14in}}>{\raggedright\arraybackslash}X@{}}%
  \textbf{#1:} & #2%
  \end{tabularx}\par\vspace{2pt}}
\newcommand{\BedrockInstructionStatus}[2]{\BedrockBlockField{#1:}{#2}}
\newcommand{\BedrockInstructionLead}[1]{\par\Needspace{0.42in}{\large #1\par}\vspace{3pt}}
\newcommand{\BedrockInstructionDescription}[1]{\par #1\par}
\newcommand{\BedrockInstructionMetadata}[4]{%
  \par\small\textcolor{BedrockMuted}{#1\enspace\textperiodcentered\enspace#2\enspace\textperiodcentered\enspace#3\enspace\textperiodcentered\enspace#4}\normalsize\par\vspace{3pt}}
\newenvironment{BedrockOperation}{\par\Needspace{0.72in}\textbf{Operation}\par\begin{BedrockCode}}{\end{BedrockCode}\par}
\newenvironment{BedrockSyntax}{\par\Needspace{0.60in}\textbf{Assembler Syntax}\par\begin{BedrockCode}}{\end{BedrockCode}\par}
\newenvironment{BedrockStatusStrip}{\par\Needspace{0.50in}\begingroup\small\noindent}{\par\endgroup\vspace{2pt}}
\newcommand{\BedrockStatusItem}[2]{\textbf{#1}\enspace#2\qquad}
\newenvironment{BedrockFlagEffects}[1]{%
  \par\Needspace{0.95in}\textbf{#1 Effects}\par
  \begin{BedrockTabular}{@{}>{\raggedright\arraybackslash}p{0.62in}>{\raggedright\arraybackslash}p{4.68in}@{}}
  \toprule
  \rowcolor{BedrockHeaderFill}\textbf{Flag} & \textbf{Effect}\\
  \midrule
}{%
  \bottomrule
  \end{BedrockTabular}
  \par
}
\newcommand{\BedrockFlagEffect}[2]{\texttt{#1} & #2\\}
\newenvironment{BedrockEAProfile}{\par\Needspace{1.1in}\begingroup\small\raggedright}{\par\endgroup}
\newcommand{\BedrockEAProfileTitle}[1]{%
  \par\Needspace{0.48in}{\large\bfseries #1\par}\vspace{4pt}}
\newcommand{\BedrockEAProfileLine}[2]{\par\hangindent=1.08in\hangafter=1\textbf{#1:}\enspace#2\par}
\newcommand{\BedrockEAProfileSyntax}[1]{\par\noindent\mbox{\texttt{#1}}\par}
\newcommand{\BedrockSummaryMnemonic}[2]{\hyperref[#1]{\texttt{#2}}}
\newenvironment{BedrockInstructionFormat}{%
  \par\Needspace{1.55in}%
  \noindent\textbf{Instruction Format:}\par
}{%
  \par}
\newenvironment{BedrockInstructionForms}{%
  \par
}{%
  \par}
\newcommand{\BedrockInstructionFormsHeading}{%
  {\normalsize\bfseries Encodings:\par}\vspace{6pt}}
\newcommand{\BedrockInstructionFormatHeading}{%
  \par\Needspace{1.25in}%
  {\normalsize\bfseries Instruction Format:\par}\vspace{3pt}}
\newcommand{\BedrockInstructionRestrictionsHeading}{%
  \par\Needspace{0.70in}%
  {\normalsize\bfseries Restrictions:\par}\vspace{3pt}}
\newcommand{\BedrockInstructionRestrictionRow}[2]{%
  \par\Needspace{0.36in}%
  \begingroup\leftskip=0.24in%
  \noindent\textbf{#1}:\enspace#2\par\endgroup\vspace{2pt}}
\newcommand{\BedrockInstructionOperandConstraint}[4]{%
  \BedrockInstructionRestrictionRow{Operand constraint}{%
    Role \texttt{#1}; relation \texttt{#2}; values \texttt{#3}; reason
    \texttt{#4}.}}
\newcommand{\BedrockInstructionOperandOverlap}[3]{%
  \BedrockInstructionRestrictionRow{Operand overlap}{%
    Operands \texttt{#1}, \texttt{#2}; rule \texttt{#3}.}}
\newcommand{\BedrockInstructionDescriptionHeading}[1]{%
  \par\Needspace{0.80in}%
  \subsection*{#1}}
\newenvironment{BedrockCode}{\par\begingroup\small\ttfamily\raggedright}{\par\endgroup}
\newcommand{\BedrockCodeLine}[1]{\noindent #1\par}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
\newcolumntype{Z}{>{\raggedright\arraybackslash\ttfamily\footnotesize}X}


\endinput
