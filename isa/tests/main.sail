function main() -> unit = {
  assert(catalog_count(primary_form_catalog()) == 484);
  expect_form(0x0000000000000060, ExtraShort, "extrashort.clr_q_rn_r");
  expect_form(0x000000000000000F, Short, "short.mov_x_rn_s_rn_d");
  expect_form(0x0000000000006480, Medium, "medium.abs_x_ea.2");

  expect_frame([|0x60|], FixedExtraShort, 1);
  expect_frame([|0x80, 0x0F|], FixedShort, 2);
  expect_invalid_frame([|0x80|]);
  expect_invalid_frame([|0x60, 0x00|]);

  expect_frame([|0xC7, 0xEF, 0x46, 0x01|], ExtendedLong, 4);
  expect_frame([|0xCB, 0xEF, 0x46, 0x01, 0xA5|], ExtendedLong, 5);
  expect_invalid_frame([|0xC3, 0xEF, 0x46|]);
  match canonical_zero_padding([|0xCB, 0xEF, 0x46, 0x01, 0xA5|], 4) {
    Some(bytes) => assert(bytes == [|0xCB, 0xEF, 0x46, 0x01, 0x00|]),
    None() => assert(false),
  };

  expect_invalid_frame([|0xC0, 0x27, 0x84, 0x34, 0x12|]);
  expect_frame([|0xC8, 0x27, 0x84, 0x34, 0x12|], ExtendedMedium, 5);
  expect_frame([|0xCC, 0x27, 0x84, 0x34, 0x12, 0xA5|], ExtendedMedium, 6);
  expect_frame([|
    0xFC, 0x27, 0x84, 0x34, 0x12, 0xA5, 0xA5, 0xA5, 0xA5,
    0xA5, 0xA5, 0xA5, 0xA5, 0xA5, 0xA5, 0xA5, 0xA5, 0xA5
  |], ExtendedMedium, 18);
  match frame_record([|0xC8, 0x27, 0x84, 0x34, 0x12|]) {
    Some(frame) => assert(required_bytes_sufficient(frame, 5)),
    None() => assert(false),
  };
  match canonical_zero_padding([|0xCC, 0x27, 0x84, 0x34, 0x12, 0xA5|], 5) {
    Some(bytes) => assert(bytes == [|0xCC, 0x27, 0x84, 0x34, 0x12, 0x00|]),
    None() => assert(false),
  };

  expect_decoded([|0x60|], Clear, SizeQ, 0x0, 0x0);
  expect_decoded([|0x6F|], Clear, SizeQ, 0xF, 0xF);
  expect_decoded([|0x80, 0x0F|], Move, SizeL, 0x0, 0xF);
  expect_decoded([|0x81, 0xF0|], Move, SizeQ, 0xF, 0x0);
  expect_decoded([|0x88, 0x12|], And, SizeL, 0x1, 0x2);
  expect_decoded([|0x89, 0x12|], And, SizeQ, 0x1, 0x2);
  expect_decoded([|0x8A, 0x12|], Or, SizeL, 0x1, 0x2);
  expect_decoded([|0x8B, 0x12|], Or, SizeQ, 0x1, 0x2);
  expect_decoded([|0x8C, 0x12|], Xor, SizeL, 0x1, 0x2);
  expect_decoded([|0x8D, 0x12|], Xor, SizeQ, 0x1, 0x2);
  expect_not_decoded([|0x82, 0x00|]);
  expect_not_decoded([|0xA0, 0x00|]);
  expect_not_decoded([|0xA0, 0x01|]);
  expect_not_decoded([|0x80|]);
  expect_not_decoded([|0x80, 0x00, 0x00|]);

  expect_execution();
  test_full_decode();
  print_endline("sail tests: ok")
}
