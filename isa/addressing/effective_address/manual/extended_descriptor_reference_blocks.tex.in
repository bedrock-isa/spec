\begin{manualformblock}{4.75in}
\textbf{\texttt{EXT1 Explicit Segment Base}}\par
\vspace{2pt}
\begin{manualeaprofile}
@EXPLICIT_SEGMENT_BASE_SYNTAX@
@EXPLICIT_SEGMENT_BASE_DESCRIPTOR@
\manualeaprofileline{Generation}{offset = temporary Rn(b) + displacement.}
\manualeaprofileline{Segment}{SEG(s) selects DS, SS, or GS0..GS5.}
\manualeaprofileline{Payload}{One descriptor byte plus the optional displacement selected by the compact EXT1 escape.}
\manualeaprofileline{Update}{No auto-update.}
\end{manualeaprofile}
\manualeaadditivememoryflow{EXT1 explicit segment base}{BASE REGISTER}{Rn(b)}{optional displacement}{EFFECTIVE ADDRESS}
\end{manualformblock}
\begin{manualformblock}{6.43in}
\textbf{\texttt{EXT2 Explicit Segment Indexed}}\par
\vspace{2pt}
\begin{manualeaprofile}
@EXPLICIT_SEGMENT_INDEXED_SYNTAX@
@EXPLICIT_SEGMENT_INDEXED_DESCRIPTOR@
\manualeaprofileline{Generation}{offset = temporary Rn(b) + index\_term * scale + displacement.}
\manualeaprofileline{Segment}{SEG(s) selects DS, SS, or GS0..GS5.}
\manualeaprofileline{Scale}{Scale is implicit in the consuming instruction. B/W/L/Q normally imply 1/2/4/8.}
\manualeaprofileline{Payload}{Two descriptor bytes plus the optional displacement selected by the compact EXT2 escape.}
\manualeaprofileline{Update}{Index postincrement uses the current temporary Rn(i), then increments it by one element. Index predecrement decrements temporary Rn(i) by one element before use.}
\end{manualeaprofile}
\manualeaindexedmemoryflow{EXT2 explicit segment indexed}{BASE REGISTER}{Rn(b)}{optional displacement}{Rn(i)}{EFFECTIVE ADDRESS}
\end{manualformblock}
\begin{manualformblock}{4.25in}
\textbf{\texttt{EXT1 Explicit Segment Zero Base}}\par
\vspace{2pt}
\begin{manualeaprofile}
@EXPLICIT_SEGMENT_ZERO_BASE_SYNTAX@
@EXPLICIT_SEGMENT_ZERO_BASE_DESCRIPTOR@
\manualeaprofileline{Generation}{offset = displacement. Without a displacement payload, offset is 0.}
\manualeaprofileline{Segment}{SEG(s) selects DS, SS, or GS0..GS5.}
\manualeaprofileline{Payload}{One descriptor byte plus the optional displacement selected by the compact EXT1 escape.}
\manualeaprofileline{Update}{No auto-update.}
\end{manualeaprofile}
\manualeasimplememoryflow{EXT1 zero-base address generation}{ZERO BASE}{0 plus displacement}{EFFECTIVE ADDRESS}
\end{manualformblock}
\begin{manualformblock}{5.07in}
\textbf{\texttt{EXT2 Explicit Segment Base Auto-Update}}\par
\vspace{2pt}
\begin{manualeaprofile}
@EXPLICIT_SEGMENT_BASE_UPDATE_SYNTAX@
@EXPLICIT_SEGMENT_BASE_UPDATE_DESCRIPTOR@
\manualeaprofileline{Generation}{offset = base\_term + displacement.}
\manualeaprofileline{Segment}{SEG(s) selects DS, SS, or GS0..GS5.}
\manualeaprofileline{Payload}{Two descriptor bytes plus the optional displacement selected by the compact EXT2 escape.}
\manualeaprofileline{Update}{Base postincrement uses the current temporary Rn(b), then increments it by the memory access size. Base predecrement decrements temporary Rn(b) by the memory access size before use.}
\end{manualeaprofile}
\manualeaadditivememoryflow{EXT2 base auto-update}{BASE REGISTER}{Rn(b) temporary}{optional displacement}{EFFECTIVE ADDRESS}
\end{manualformblock}
\begin{manualformblock}{6.43in}
\textbf{\texttt{EXT2 Explicit Segment Zero-Base Indexed}}\par
\vspace{2pt}
\begin{manualeaprofile}
@EXPLICIT_SEGMENT_ZERO_BASE_INDEXED_SYNTAX@
@EXPLICIT_SEGMENT_ZERO_BASE_INDEXED_DESCRIPTOR@
\manualeaprofileline{Generation}{offset = index\_term * scale + displacement.}
\manualeaprofileline{Segment}{SEG(s) selects DS, SS, or GS0..GS5.}
\manualeaprofileline{Payload}{Two descriptor bytes plus the optional displacement selected by the compact EXT2 escape.}
\manualeaprofileline{Update}{Index update follows the same one-element temporary-image rule as other indexed update forms.}
\end{manualeaprofile}
\manualeaindexedmemoryflow{EXT2 zero-base indexed}{ZERO BASE}{0}{optional displacement}{Rn(i)}{EFFECTIVE ADDRESS}
\end{manualformblock}
\begin{manualformblock}{6.43in}
\textbf{\texttt{EXT2 SP/PC Indexed}}\par
\vspace{2pt}
\begin{manualeaprofile}
@SP_PC_INDEXED_SYNTAX@
@SP_PC_INDEXED_DESCRIPTOR@
\manualeaprofileline{Generation}{offset = temporary SP or instruction-start PC + index\_term * scale + displacement. A PC term names byte 0 of the current instruction.}
\manualeaprofileline{Segment}{SP forms are fixed to SS. PC forms are fixed to CS.}
\manualeaprofileline{Payload}{Two descriptor bytes plus the optional displacement selected by the compact EXT2 escape.}
\manualeaprofileline{Update}{Auto-update applies to the Rn(i) index register.}
\end{manualeaprofile}
\manualeaindexedmemoryflow{EXT2 SP/PC indexed}{SP OR PC}{SP or PC term}{optional displacement}{Rn(i)}{EFFECTIVE ADDRESS}
\end{manualformblock}
\begin{manualformblock}{4.91in}
\textbf{\texttt{EXT1 Default-Segment Base Auto-Update}}\par
\vspace{2pt}
\begin{manualeaprofile}
@DEFAULT_SEGMENT_BASE_UPDATE_SYNTAX@
@DEFAULT_SEGMENT_BASE_UPDATE_DESCRIPTOR@
\manualeaprofileline{Generation}{offset = base\_term + displacement.}
\manualeaprofileline{Segment}{Uses the operation default data segment.}
\manualeaprofileline{Payload}{One descriptor byte plus the optional displacement selected by the compact EXT1 escape.}
\manualeaprofileline{Update}{Postincrement uses the current temporary Rn(b), then increments it by the memory access size. Predecrement decrements temporary Rn(b) by the memory access size before use.}
\end{manualeaprofile}
\manualeaadditivememoryflow{EXT1 default-segment base auto-update}{BASE REGISTER}{Rn(b) temporary}{optional displacement}{EFFECTIVE ADDRESS}
\end{manualformblock}
