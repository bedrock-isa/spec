prelude {
  files
    prelude/prelude.sail,
    prelude/semantic_types.sail
}

catalog_types {
  requires prelude, operations
  files catalog/types.sail
}

decode {
  requires prelude, operations, catalog_types, catalog
  files
    decode/framing.sail,
    decode/instruction.sail
}

fp {
  requires prelude, operations, catalog_types, catalog
  files
    fp/catalog.sail,
    fp/types.sail,
    fp/semantics.sail
}

core {
  requires prelude, operations, catalog_types, catalog, decode, fp
  files
    core/types.sail,
    core/base.sail,
    core/integer.sail,
    core/system.sail,
    core/memory.sail,
    core/events.sail,
    core/repeat.sail,
    core/control.sail,
    core/floating_point.sail,
    core/dispatch.sail,
    core/resume.sail
}

postlude {
  requires prelude, operations, catalog_types, catalog, decode, fp, core
  files postlude/boundary.sail
}

unit_tests {
  requires prelude, operations, catalog_types, catalog, decode, fp, core, postlude
  files
    unit_tests/support.sail,
    unit_tests/coverage.sail,
    unit_tests/pairs.sail,
    unit_tests/transactions.sail,
    unit_tests/integer.sail,
    unit_tests/state.sail,
    unit_tests/protocol.sail,
    unit_tests/event.sail,
    unit_tests/floating_point.sail,
    unit_tests/full.sail,
    unit_tests/smoke.sail
}

main {
  requires prelude, operations, catalog_types, catalog, decode, fp, core, postlude, unit_tests
  files main/main.sail
}
