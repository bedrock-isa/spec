export function w $switch_jump_table(w %t0, w %t1) {
@l0
	%x =p alloc4 4
	storew %t0, %x
	%bias =p alloc4 4
	storew %t1, %bias
	%t3 =w loadw %x
	%t2 =w and %t3, 7
	%t5 =l extsw %t2
	%t6 =l mul 4, %t5
	%t7 =p copy $glo1
	%t8 =p add %t7, %t6
	%t9 =w loadw %t8
	%t10 =w loadw %bias
	%t11 =w add %t10, %t9
	ret %t11
}

data $glo1 = { w 3 5 7 11 13 17 19 23 }
