export function w $mv_sum(p %t0, w %t1) {
@l0
	%p =p alloc8 8
	storel %t0, %p
	%n =p alloc4 4
	storew %t1, %n
	%i =p alloc4 4
	%acc =p alloc4 4
	storew 0, %i
	storew 0, %acc
@l1
	%t7 =w loadw %i
	%t8 =w loadw %n
	%t6 =w csltw %t7, %t8
	jnz %t6, @l2, @l3
@l2
	%t11 =w loadw %acc
	%t14 =p loadl %p
	%t15 =w loadw %i
	%t16 =l extsw %t15
	%t17 =l mul 4, %t16
	%t13 =p add %t14, %t17
	%t12 =w loadw %t13
	%t10 =w add %t11, %t12
	storew %t10, %acc
	%t20 =w loadw %i
	%t19 =w add %t20, 1
	storew %t19, %i
	jmp @l1
@l3
	%t22 =w loadw %acc
	ret %t22
}

