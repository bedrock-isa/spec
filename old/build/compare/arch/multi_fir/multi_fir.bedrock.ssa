export function w $mf_fir_three(p %t0, p %t1, w %t2, w %t3, w %t4, w %t5) {
@l0
	%dst =p alloc8 8
	storel %t0, %dst
	%src =p alloc8 8
	storel %t1, %src
	%n =p alloc4 4
	storew %t2, %n
	%ca =p alloc4 4
	storew %t3, %ca
	%cb =p alloc4 4
	storew %t4, %cb
	%cc =p alloc4 4
	storew %t5, %cc
	%i =p alloc4 4
	%va =p alloc4 4
	%vb =p alloc4 4
	%vc =p alloc4 4
	%out =p alloc4 4
	storew 0, %i
@l1
	%t9 =w loadw %i
	%t10 =w loadw %n
	%t8 =w csltw %t9, %t10
	jnz %t8, @l2, @l3
@l2
	%t14 =p loadl %src
	%t15 =w loadw %i
	%t16 =l extsw %t15
	%t17 =l mul 4, %t16
	%t13 =p add %t14, %t17
	%t12 =w loadw %t13
	storew %t12, %va
	%t21 =p loadl %src
	%t23 =w loadw %i
	%t22 =w add %t23, 1
	%t25 =l extsw %t22
	%t26 =l mul 4, %t25
	%t20 =p add %t21, %t26
	%t19 =w loadw %t20
	storew %t19, %vb
	%t30 =p loadl %src
	%t32 =w loadw %i
	%t31 =w add %t32, 2
	%t34 =l extsw %t31
	%t35 =l mul 4, %t34
	%t29 =p add %t30, %t35
	%t28 =w loadw %t29
	storew %t28, %vc
	%t38 =w loadw %va
	%t39 =w loadw %ca
	%t37 =w mul %t38, %t39
	storew %t37, %out
	%t42 =w loadw %out
	%t44 =w loadw %vb
	%t45 =w loadw %cb
	%t43 =w mul %t44, %t45
	%t41 =w add %t42, %t43
	storew %t41, %out
	%t48 =w loadw %out
	%t50 =w loadw %vc
	%t51 =w loadw %cc
	%t49 =w mul %t50, %t51
	%t47 =w add %t48, %t49
	storew %t47, %out
	%t53 =w loadw %out
	%t55 =p loadl %dst
	%t56 =w loadw %i
	%t57 =l extsw %t56
	%t58 =l mul 4, %t57
	%t54 =p add %t55, %t58
	storew %t53, %t54
	%t61 =w loadw %i
	%t60 =w add %t61, 1
	storew %t60, %i
	jmp @l1
@l3
	%t63 =w loadw %i
	ret %t63
}

export function w $mf_scale_store(p %t0, p %t1, w %t2) {
@l4
	%dst =p alloc8 8
	storel %t0, %dst
	%src =p alloc8 8
	storel %t1, %src
	%n =p alloc4 4
	storew %t2, %n
	%i =p alloc4 4
	%v =p alloc4 4
	storew 0, %i
@l5
	%t6 =w loadw %i
	%t7 =w loadw %n
	%t5 =w csltw %t6, %t7
	jnz %t5, @l6, @l7
@l6
	%t11 =p loadl %src
	%t12 =w loadw %i
	%t13 =l extsw %t12
	%t14 =l mul 4, %t13
	%t10 =p add %t11, %t14
	%t9 =w loadw %t10
	storew %t9, %v
	%t18 =w loadw %v
	%t17 =w mul %t18, 4
	%t16 =w add %t17, 1
	%t22 =p loadl %dst
	%t23 =w loadw %i
	%t24 =l extsw %t23
	%t25 =l mul 4, %t24
	%t21 =p add %t22, %t25
	storew %t16, %t21
	%t28 =w loadw %i
	%t27 =w add %t28, 1
	storew %t27, %i
	jmp @l5
@l7
	%t30 =w loadw %i
	ret %t30
}

export function w $mf_bias_sum(p %t0, w %t1, w %t2) {
@l8
	%p =p alloc8 8
	storel %t0, %p
	%n =p alloc4 4
	storew %t1, %n
	%bias =p alloc4 4
	storew %t2, %bias
	%i =p alloc4 4
	%acc =p alloc4 4
	storew 0, %i
	storew 0, %acc
@l9
	%t8 =w loadw %i
	%t9 =w loadw %n
	%t7 =w csltw %t8, %t9
	jnz %t7, @l10, @l11
@l10
	%t13 =w loadw %acc
	%t16 =p loadl %p
	%t17 =w loadw %i
	%t18 =l extsw %t17
	%t19 =l mul 4, %t18
	%t15 =p add %t16, %t19
	%t14 =w loadw %t15
	%t12 =w add %t13, %t14
	%t20 =w loadw %bias
	%t11 =w add %t12, %t20
	storew %t11, %acc
	%t23 =w loadw %i
	%t22 =w add %t23, 1
	storew %t22, %i
	jmp @l9
@l11
	%t25 =w loadw %acc
	ret %t25
}

export function w $mf_pipeline(p %t0, p %t1, p %t2, w %t3, w %t4, w %t5, w %t6) {
@l12
	%tmp =p alloc8 8
	storel %t0, %tmp
	%dst =p alloc8 8
	storel %t1, %dst
	%src =p alloc8 8
	storel %t2, %src
	%n =p alloc4 4
	storew %t3, %n
	%ca =p alloc4 4
	storew %t4, %ca
	%cb =p alloc4 4
	storew %t5, %cb
	%cc =p alloc4 4
	storew %t6, %cc
	%a =p alloc4 4
	%b =p alloc4 4
	%t9 =p loadl %tmp
	%t10 =p loadl %src
	%t11 =w loadw %n
	%t12 =w loadw %ca
	%t13 =w loadw %cb
	%t14 =w loadw %cc
	%t8 =w call $mf_fir_three(p %t9, p %t10, w %t11, w %t12, w %t13, w %t14)
	storew %t8, %a
	%t17 =p loadl %dst
	%t18 =p loadl %tmp
	%t19 =w loadw %n
	%t16 =w call $mf_scale_store(p %t17, p %t18, w %t19)
	storew %t16, %b
	%t21 =p loadl %dst
	%t22 =w loadw %n
	%t24 =w loadw %a
	%t25 =w loadw %b
	%t23 =w add %t24, %t25
	%t20 =w call $mf_bias_sum(p %t21, w %t22, w %t23)
	ret %t20
}

