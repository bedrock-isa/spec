function primary_form_catalog_for(encoding_class : Encoding_class) -> list(Catalog_entry) =
  match encoding_class {
    ExtraShort => primary_form_catalog_extrashort_cache,
    Short => primary_form_catalog_short_cache,
    Medium => primary_form_catalog_medium_cache,
    Long => primary_form_catalog_long_cache,
    ExtraLong => primary_form_catalog_extralong_cache,
    Xxlong => primary_form_catalog_xxlong_cache,
  }

